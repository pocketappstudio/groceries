require 'base64'
default_platform(:ios)
platform :ios do
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_content: ENV["ASC_KEY_P8"], is_key_content_base64: true)
    team = ENV["APPLE_TEAM_ID"]
    ids = { "App" => "com.pocketappstudio.restock", "RestockWidget" => "com.pocketappstudio.restock.widget" }
    File.binwrite("/tmp/dist.p12", Base64.decode64(ENV["DIST_CERT_P12_BASE64"]))
    import_certificate(certificate_path: "/tmp/dist.p12", certificate_password: ENV["DIST_CERT_PASSWORD"], keychain_name: "fastlane_tmp_keychain", keychain_password: "")
    # App Store profiles created through the API key (no devices needed).
    profiles = {}
    ids.each_value do |id|
      sigh(api_key: api_key, app_identifier: id, team_id: team, force: true, filename: "#{id}.mobileprovision")
      profiles[id] = lane_context[SharedValues::SIGH_NAME]
    end
    increment_build_number(xcodeproj: "ios/App/App.xcodeproj", build_number: ENV["GITHUB_RUN_NUMBER"])
    ids.each do |target, id|
      update_code_signing_settings(use_automatic_signing: false, path: "ios/App/App.xcodeproj", targets: [target], team_id: team,
        code_sign_identity: "Apple Distribution", profile_name: profiles[id], bundle_identifier: id)
    end
    build_app(project: "ios/App/App.xcodeproj", scheme: "App", configuration: "Release", export_method: "app-store",
      export_options: { signingStyle: "manual", teamID: team, provisioningProfiles: profiles })
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
